{
	"cSpell.ignorePaths": [".git", ".vscode", "*.sh"],
	"files.associations": {
		"*.ps1.template": "powershell"
	},
	"yaml.schemas": {
		"resources/cli/cli-parser.schema.json": [
			".cli-parser.yml",
			".cli_parser.yaml",
			"source/cli/config.yml"
		]
	},
	"json.schemas": [
		{
			"fileMatch": [".cli_parser.json"],
			"url": "./resources/cli/cli-parser.schema.json"
		}
	]
}
